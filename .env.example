# Copy to .env and fill in.

# --- Required ---
# Long random string used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=

# MySQL / MariaDB
MIKRO_ORM_HOST=127.0.0.1
MIKRO_ORM_PORT=3306
MIKRO_ORM_USER=tiri
MIKRO_ORM_PASSWORD=tiri
MIKRO_ORM_DB_NAME=tiri_relay

# --- Server ---
PORT=3003
# true = HTTPS on 443 with ./test.key and ./test.crt
USE_SSL=false
# Name shown in the sign-in message the wallet signs
RELAY_DOMAIN=relay.tiri.local

# --- Filecoin network (read-only; used by billing, checked by /api/health) ---
# calibration (testnet) or mainnet
FILECOIN_NETWORK=calibration
# Optional; defaults to the public Glif endpoint of the network above
# FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# --- Optional tuning ---
# SESSION_TTL_SECONDS=2592000
# CHALLENGE_TTL_SECONDS=300
# MAX_TREE_BYTES=8388608
# MIKRO_ORM_DEBUG=false

# --- Feedback email (optional) ---
MAIL_HOST=
MAIL_PORT=465
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_TO=
