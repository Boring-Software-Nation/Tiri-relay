# Copy to /opt/tiri/relay.env on the server and fill in. Keep this file private (chmod 600).
# Generate secrets with:  openssl rand -base64 48

# --- Relay ---
AUTH_SECRET=change-me
# Must match the public host name (shown in the sign-in message the wallet signs)
RELAY_DOMAIN=relay.example.com
FILECOIN_NETWORK=calibration
# FILECOIN_RPC_URL=https://api.calibration.node.glif.io/rpc/v1

# --- Database (used by both the relay and the MySQL container) ---
MIKRO_ORM_USER=tiri
MIKRO_ORM_PASSWORD=change-me
MIKRO_ORM_DB_NAME=tiri_relay
# The MySQL container creates this database and user on first start (keep the values equal)
MYSQL_DATABASE=tiri_relay
MYSQL_USER=tiri
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# --- Feedback email (optional) ---
MAIL_HOST=
MAIL_PORT=465
MAIL_ADDRESS=
MAIL_PASSWORD=
MAIL_TO=
